# HABIL frontend environment examples (non-secret)
#
# Local backend fallback used by the app when REACT_APP_API_URL is unset:
# REACT_APP_API_URL=http://localhost:5001/api
# Vite alias during the parallel migration:
# VITE_API_URL=http://localhost:5001/api
#
# Staging/dev backend smoke:
# REACT_APP_API_URL=https://<dev-backend>.vercel.app/api
#
# Production read-only smoke only. Do not use this for local write testing:
# REACT_APP_API_URL=https://habil-backend.vercel.app/api
