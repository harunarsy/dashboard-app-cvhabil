# Database Configuration (Local)
DB_USER=dashboard_user
DB_PASSWORD=test_password_123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard_db

# Database Configuration (Remote/Cloud)
# Only use this if you want to connect to a Cloud database from local.
# DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]
# HABIL_DB_TARGET=dev
# Allowed values: dev, audit, prod-smoke, prod (local prod requires ALLOW_PROD_LOCAL=true)
# ALLOW_PROD_LOCAL=false

# Server Configuration
